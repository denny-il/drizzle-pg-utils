{
  "name": "@denny-il/drizzle-pg-utils",
  "description": "Set of utilities for Drizzle ORM and PostgreSQL",
  "homepage": "https://github.com/denny-il/drizzle-pg-utils",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "postgres",
    "pg",
    "utils",
    "json",
    "temporal"
  ],
  "author": {
    "name": "Denny Il",
    "email": "ilchishin.denis@gmail.com",
    "url": "https://github.com/denny-il"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denny-il/drizzle-pg-utils.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "module-sync": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./json": {
      "import": "./src/json/index.ts",
      "module-sync": "./src/json/index.ts",
      "types": "./src/json/index.ts"
    },
    "./json/*": {
      "import": "./src/json/operations/*.ts",
      "module-sync": "./src/json/operations/*.ts",
      "types": "./src/json/operations/*.ts"
    },
    "./temporal": {
      "import": "./src/temporal/index.ts",
      "module-sync": "./src/temporal/index.ts",
      "types": "./src/temporal/index.ts"
    },
    "./temporal/global": {
      "import": "./src/temporal/global.ts",
      "module-sync": "./src/temporal/global.ts",
      "types": "./src/temporal/global.ts"
    },
    "./temporal/polyfill": {
      "import": "./src/temporal/polyfill.ts",
      "module-sync": "./src/temporal/polyfill.ts",
      "types": "./src/temporal/polyfill.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./json": {
        "import": "./dist/json/index.js",
        "module-sync": "./dist/json/index.js",
        "types": "./dist/json/index.d.ts"
      },
      "./json/*": {
        "import": "./dist/json/operations/*.js",
        "module-sync": "./dist/json/operations/*.js",
        "types": "./dist/json/operations/*.d.ts"
      },
      "./temporal": {
        "import": "./dist/temporal/index.js",
        "module-sync": "./dist/temporal/index.js",
        "types": "./dist/temporal/index.d.ts"
      },
      "./temporal/global": {
        "import": "./dist/temporal/global.js",
        "module-sync": "./dist/temporal/global.js",
        "types": "./dist/temporal/global.d.ts"
      },
      "./temporal/polyfill": {
        "import": "./dist/temporal/polyfill.js",
        "module-sync": "./dist/temporal/polyfill.js",
        "types": "./dist/temporal/polyfill.d.ts"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --build tsconfig.build.json",
    "check:type": "tsc --noEmit",
    "check:lint": "oxlint --deny-warnings",
    "check:fmt": "oxfmt --check",
    "check": "pnpm run check:fmt && pnpm run check:lint && pnpm run check:type",
    "fmt": "oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "^22.20.5",
    "drizzle-orm": "1.0.0-rc.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "postgres": "^3.4.9",
    "temporal-polyfill": "^1.0.6",
    "typescript": "7.1.0-beta",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "temporal-polyfill": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "temporal-polyfill": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
